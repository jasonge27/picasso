include *.md *.rst
include LICENSE
recursive-include pycasso *.py VERSION
recursive-include pycasso/src *
prune pycasso/lib
prune pycasso/src/build
prune pycasso/src/lib
# Source distributions must compile for the target host. Never retain a
# binary from the machine that assembled the sdist.
global-exclude *.so
global-exclude *.dylib
global-exclude *.dll
global-exclude *.o
global-exclude *.d
global-exclude *.a
global-exclude *.pyo
global-exclude *.pyc
global-exclude .DS_Store
